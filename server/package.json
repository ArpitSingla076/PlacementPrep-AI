{
  "name": "placementprep-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PlacementPrep AI - Express API",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "ai:check": "node --env-file-if-exists=.env scripts/ai-check.js",
    "vector:index": "node --env-file-if-exists=.env scripts/create-vector-index.js",
    "rag:eval": "node --env-file-if-exists=.env scripts/rag-eval.js",
    "ai:check:full": "node --env-file-if-exists=.env scripts/ai-check.js --full"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
