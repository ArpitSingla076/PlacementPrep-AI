# ==== Copy to .env and fill in. NEVER commit the real .env file. ====
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Add your own IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/placementprep?retryWrites=true&w=majority

# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
SESSION_DAYS=7
CLIENT_URL=http://localhost:5173   # exact origin of the frontend (CORS + CSRF Origin check)
COOKIE_SAMESITE=lax                # 'none' only for cross-site hosting; see docs/DEPLOYMENT.md
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_MAX=20             # login/register attempts per IP per 15 minutes
API_RATE_LIMIT_MAX=1000            # all API requests per IP per 15 minutes
REQUEST_TIMEOUT_MS=180000          # must exceed AI_TIMEOUT_MS plus retries

# ---------------- LLM ----------------
LLM_PROVIDER=gemini
# Google AI Studio key. Server-side only: never put it in the client or commit it.
GEMINI_API_KEY=
# Required. Model IDs change often, so there is NO default in the code. Run `npm run ai:check` to list what your key can use.
# Starting suggestion (cheapest tier, labelled stable in Google's own tooling; verify it appears in the list): gemini-3.1-flash-lite
LLM_MODEL=gemini-3.1-flash-lite
LLM_MAX_OUTPUT_TOKENS=8192
# Optional, model-dependent (an unsupported value makes the API reject calls). Leave unset unless you know your model supports it.
# LLM_THINKING_LEVEL=low           # minimal | low | medium | high
# LLM_THINKING_BUDGET=0            # token budget (0 = off) for older models
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2                   # extra attempts after the first, transient errors only
AI_RETRY_BASE_MS=1500
# Optional: send SDK requests to a Gemini-compatible endpoint instead of Google. Your API key is sent to this host.
# GEMINI_BASE_URL=

# Per-user hourly quotas for calls to the provider (your cost ceiling). Cached results and failures do not count.
AI_QUOTA_PER_HOUR=10               # new resume analyses
QUESTIONS_PER_HOUR=30              # assistant questions
INGESTIONS_PER_HOUR=10             # document uploads (embedding)
INTERVIEW_CALLS_PER_HOUR=60        # interview question generation + answer evaluation
PLAN_GENERATIONS_PER_HOUR=5
QUIZ_GENERATIONS_PER_HOUR=10       # quiz creation

# ---------------- Embeddings and RAG ----------------
EMBEDDING_PROVIDER=gemini
# Candidates from Google's cookbook: gemini-embedding-001 (text) or gemini-embedding-2 (multimodal). Confirm with `npm run ai:check`.
EMBEDDING_MODEL=
# Must match the Atlas vector index numDimensions. If blank the model's default size is used (npm run ai:check prints it).
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_USE_TASK_TYPE=true       # set false if ai:check reports taskType is rejected

VECTOR_SEARCH_MODE=atlas           # 'local' = cosine in Node, for dev/tests WITHOUT Atlas only
VECTOR_INDEX_NAME=chunk_embedding_index
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200            # must be less than half of CHUNK_SIZE_CHARS
RAG_TOP_K=5
RAG_NUM_CANDIDATES=50
RAG_MIN_SCORE=0                    # 0..1 similarity floor (0 = off). Tune with `npm run rag:eval`.
RAG_MAX_CONTEXT_CHARS=9000
MAX_QUESTION_CHARS=1000

# ---------------- Upload and content limits ----------------
MAX_UPLOAD_MB=5                    # resumes
MAX_RESUMES_PER_USER=10
MAX_RESUME_PAGES=6
MAX_RESUME_CHARS=25000
MIN_RESUME_CHARS=200
MAX_JD_CHARS=10000
MIN_JD_CHARS=100
MAX_DOC_UPLOAD_MB=10               # study notes
MAX_DOCS_PER_USER=20
MAX_DOC_PAGES=100
MAX_CHUNKS_PER_DOC=400
MAX_APPLICATIONS_PER_USER=200
MAX_QUIZZES_PER_USER=50
MAX_ANSWER_CHARS=4000
MAX_INTERVIEW_JD_CHARS=4000
